# ---------------------------------------------------------------------------
# Copy to .env and fill in before starting. In production the server refuses
# to boot unless every secret below is set — it will not silently generate
# throwaway values and pretend the install is ready.
#
# Generate each secret with:  openssl rand -hex 32
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=4000

# Set when the app runs behind a reverse proxy, so client IPs in the audit log
# and the rate limiter are the real ones rather than the proxy's.
# The value is passed to Express's "trust proxy" setting.
TRUST_PROXY=1

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# SQLite database file. Put it on persistent, backed-up storage.
DB_PATH=/var/lib/fxp/platform.db

# Uploaded payment evidence and identity images. MUST be outside the web root
# and outside any directory the web server can execute from.
UPLOAD_DIR=/var/lib/fxp/uploads

# ---------------------------------------------------------------------------
# Secrets — at least 32 characters each, and never committed
# ---------------------------------------------------------------------------
# Signs nothing by itself; it seeds session material.
SESSION_SECRET=

# Keys the HMAC that OTP codes are stored under. Rotating it invalidates every
# outstanding code, which is safe — users simply request a new one.
OTP_SECRET=

# Exactly 64 hex characters (32 bytes). Encrypts identity document numbers with
# AES-256-GCM. LOSING THIS MAKES EXISTING KYC RECORDS UNREADABLE. Back it up
# separately from the database, or an attacker with the database backup gains
# nothing but you lose the data too.
FIELD_ENCRYPTION_KEY=

# Keys the digest used to spot the same identity document on two accounts
# without decrypting anything. Rotating it stops past duplicates matching.
KYC_DIGEST_SECRET=

# ---------------------------------------------------------------------------
# Sessions and hashing
# ---------------------------------------------------------------------------
SESSION_TTL_MINUTES=720
ADMIN_SESSION_TTL_MINUTES=240
SESSION_IDLE_MINUTES=120

# bcrypt cost. 12 is a sensible floor; raise it as your hardware allows.
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# Phone verification
# ---------------------------------------------------------------------------
OTP_LENGTH=4
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60
OTP_MAX_PER_HOUR=5

# In development, with no SMS provider configured, the code is printed to the
# server log so the flow is testable. Set to false to suppress that. It is
# never printed when NODE_ENV=production.
OTP_ECHO=true

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
# The brief asked for no cap. An unbounded multipart body is a trivial way to
# fill the disk, so the cap is configurable and simply set high rather than
# removed. 32 MB by default.
UPLOAD_MAX_BYTES=33554432

# ---------------------------------------------------------------------------
# Outbound channels
# ---------------------------------------------------------------------------
# Leave blank and nothing is sent — and the platform records "not configured"
# rather than pretending a message was delivered. Implement the adapter in
# src/lib/sms.js for your provider before setting this.
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER=

EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=

# ---------------------------------------------------------------------------
# First administrator — used once, on the first run only, then ignored.
# The account is created with must_change_password set, so this password
# cannot be used for anything except setting a real one.
# ---------------------------------------------------------------------------
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Super Admin
