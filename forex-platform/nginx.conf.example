# Reverse proxy in front of the Node process.
#
# TLS terminates here, so the application's Secure cookies and HSTS header
# only make sense once this (or an equivalent) is in place.

server {
    listen 80;
    server_name example.com www.example.com;
    # ACME challenges stay on port 80; everything else is redirected.
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    server_name example.com www.example.com;

    ssl_certificate     /etc/letsencrypt/live/example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # Payment screenshots from a phone camera are large; allow for them.
    # Keep this at or just above UPLOAD_MAX_BYTES.
    client_max_body_size 32m;

    # The upload directory must never be served directly. Files are delivered
    # only through /api/files/:id and /api/admin/files/:id, which check who is
    # asking. There is deliberately no `location /uploads` block here.

    location / {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
