# Copy this file to .env and fill in real values before starting the server.

# Port the Node process listens on. On Hostinger VPS this sits behind Nginx.
PORT=3000

# Secret used to sign JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-string

# How long an auth token stays valid.
JWT_EXPIRES_IN=12h

# Path to the SQLite database file (created automatically on first run).
DB_PATH=./data/pos.db

# Credentials for the first super-admin account, created on first run only.
SUPER_ADMIN_EMAIL=admin@platform.local
SUPER_ADMIN_PASSWORD=change-this-password
SUPER_ADMIN_NAME=Platform Admin

# Comma-separated list of origins allowed to call the API (leave blank to allow same-origin only).
CORS_ORIGINS=
